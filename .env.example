# Copy this file to .env.local for local work, and set the same variables on your hosting provider.
#
# NEXT_PUBLIC_ values are public and are written into the site by `next build`: set them before
# building, and rebuild after changing one. The others stay on the server and apply at runtime.

# Public URL of the site, without a trailing slash (canonical URLs, sitemap, social cards).
# Defaults to https://intlaka.com
NEXT_PUBLIC_SITE_URL=

# Contact form (required). Emails are sent through Resend, https://resend.com
RESEND_API_KEY=
# Who receives the messages. Accepts a comma separated list.
CONTACT_TO_EMAIL=
# The sender. Must be on a domain verified in Resend. Keep the quotes when it includes a name:
# CONTACT_FROM_EMAIL="Intlaka website <website@intlaka.com>"
CONTACT_FROM_EMAIL=

# The public contact address shown on the site is fixed in src/config/site.ts (contact@intlaka.com).
# No phone number is published.

# Full URLs of your social profiles, e.g. https://www.linkedin.com/company/intlaka
# An empty value is hidden everywhere on the site.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
